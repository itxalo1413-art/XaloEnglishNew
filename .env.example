# Frontend (NOTE: NEXT_PUBLIC_* is inlined at *build* time)
# Local dev (direct to Nest):
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Production (same domain behind Nginx):
# NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_CLARITY_ID=

# Backend
BACKEND_CORS_ORIGIN=http://localhost:3000
BACKEND_MONGO_URI=mongodb://mongo:27017/xaloenglish
BACKEND_JWT_SECRET=change-me

# Seed admin (one-time)
ADMIN_SEED_EMAIL=admin@xaloenglish.vn
ADMIN_SEED_PASSWORD=change-me
ADMIN_SEED_NAME=Xalo English Admin

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=Xalo English
